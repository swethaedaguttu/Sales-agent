# ── Required (Groq) ───────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: groq | openai | anthropic
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60

# Groq (default)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (set LLM_PROVIDER=openai and provide OPENAI_API_KEY)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic (set LLM_PROVIDER=anthropic, install anthropic package)
# ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — zero config)
DATABASE_URL=sqlite:///./sales_agent.db
MEMORY_BACKEND=sqlite

# PostgreSQL example (swap backend by changing only this line + memory/factory.py)
# DATABASE_URL=postgresql://user:password@localhost:5432/sales_agent

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Sales Assistant Agent
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_MAX_TOKENS=2048
MEMORY_MAX_MESSAGES=20
MEMORY_SUMMARY_THRESHOLD=30

# ── Eval ──────────────────────────────────────────────────────────────────────
EVAL_FLAG_THRESHOLD=0.60

# ── Catalog ───────────────────────────────────────────────────────────────────
CATALOG_PATH=app/catalog.json
